# coords.test — M4/M5: .c coords / move / delete / bbox
package require tcltest
namespace import ::tcltest::*

if {[catch {package require tkd2dcanvas} err]} {
    puts "SKIP coords.test: $err"
    exit 0
}

tkd2dcanvas .c -width 320 -height 240

test coords-query "coords returns the item's flat coordinates" -body {
    set id [.c create rectangle 0 0 10 20]
    .c coords $id
} -result "0 0 10 20"

test coords-query-line "coords returns every point of a line" -body {
    set id [.c create line 1 2 3 4 5 6]
    .c coords $id
} -result "1 2 3 4 5 6"

test coords-query-unknown-item "querying an unknown id is a silent no-op" -body {
    catch {.c coords 999} msg
    set msg
} -result ""

test coords-set "coords rewrites the item's coordinates" -body {
    set id [.c create rectangle 0 0 10 10]
    .c coords $id 5 5 50 50
    .c coords $id
} -result "5 5 50 50"

test coords-set-list-arg "coords accepts a single list argument" -body {
    set id [.c create rectangle 0 0 10 10]
    .c coords $id {30 40 60 70}
    .c coords $id
} -result "30 40 60 70"

test coords-set-wrong-count "coords with the wrong arity errors and changes nothing" -body {
    set id [.c create rectangle 1 2 3 4]
    catch {.c coords $id 9 9 9 9 9 9} msg
    list $msg [.c coords $id]
} -result "{wrong # coordinates: expected 4, got 6} {1 2 3 4}"

test coords-set-line "coords can grow a polyline" -body {
    set id [.c create line 0 0 10 10]
    .c coords $id 0 0 10 10 20 0
    .c coords $id
} -result "0 0 10 10 20 0"

test move-test "move translates the item" -body {
    set id [.c create rectangle 10 10 20 20]
    .c move $id 7 3
    .c coords $id
} -result "17 13 27 23"

test move-negative "move accepts negative deltas" -body {
    set id [.c create rectangle 10 10 20 20]
    .c move $id -5 -5
    .c coords $id
} -result "5 5 15 15"

test move-by-tag "move works on tags created via -tags" -body {
    set id [.c create rectangle 0 0 10 10 -tags node]
    .c move node 100 0
    .c coords $id
} -result "100 0 110 10"

test move-unknown-id "moving an unknown id is a silent no-op" -body {
    catch {.c move 9999 1 1} msg
    set msg
} -result ""

test delete-test "delete removes the item" -body {
    set id [.c create rectangle 0 0 10 10]
    .c delete $id
    expr {[catch {.c coords $id} msg] == 0 && $msg eq ""}
} -result 1

test delete-multiple "delete removes every listed spec" -body {
    set a [.c create rectangle 5000 5000 5010 5010]
    set b [.c create oval 5100 5100 5110 5110]
    .c delete $a $b
    list [.c coords $a] [.c coords $b]
} -result {{} {}}

test delete-all "delete all removes every item" -body {
    .c create rectangle 0 0 10 10
    .c create line 0 0 5 5
    .c delete all
    list [.c bbox all] [winfo exists .c]
} -result {{} 1}

test bbox-single "bbox reports the item's Tk bounding box" -body {
    set id [.c create rectangle 10 10 100 80]
    .c bbox $id
} -result "9 9 101 81"

test bbox-union "bbox unions multiple items" -body {
    set a [.c create rectangle 10 10 20 20]
    set b [.c create rectangle 100 100 200 300]
    .c bbox $a $b
} -result "9 9 201 301"

test bbox-empty-match "bbox with no matching items returns the empty string" -body {
    .c bbox no-such-tag
} -result ""

test bbox-unknown-id "bbox on an unknown id is a silent no-op" -body {
    catch {.c bbox 424242} msg
    set msg
} -result ""

destroy .c

if {![info exists ::tkg_all_in_progress]} {
    cleanupTests
}
