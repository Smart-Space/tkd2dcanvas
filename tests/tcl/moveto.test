# moveto.test — .c moveto (Tk 8.6 semantics) and the Tk-compatible line bbox.
# The expected bbox values were measured against Tk 8.6.18 (tkCanvLine.c:
# ComputeLineBbox — integer canvas units, padded by (int)(width+0.5) plus a
# 1px fudge; -joinstyle miter adds the miter apex points; smooth curves do
# not participate).
package require tcltest
namespace import ::tcltest::*

if {[catch {package require tkd2dcanvas} err]} {
    puts "SKIP moveto.test: $err"
    exit 0
}

tkd2dcanvas .c -width 320 -height 240

# --- line bbox: the Tk "approximate" bounding box ---------------------------
test line-bbox-simple "line bbox is the Tk-inflated int box" -body {
    set id [.c create line 10 10 50 30]
    .c bbox $id
} -result "8 8 52 32"

test line-bbox-horizontal "horizontal line bbox" -body {
    set id [.c create line 0 20 100 20]
    .c bbox $id
} -result "-2 18 102 22"

test line-bbox-vertical "vertical line bbox" -body {
    set id [.c create line 20 0 20 100]
    .c bbox $id
} -result "18 -2 22 102"

test line-bbox-width-2 "width widens the bbox" -body {
    set id [.c create line 10 10 50 30 -width 2]
    .c bbox $id
} -result "7 7 53 33"

test line-bbox-width-fractional "width rounds half up" -body {
    set id [.c create line 10 10 50 30 -width 4.4]
    set a [.c bbox $id]
    .c itemconfigure $id -width 4.5
    set b [.c bbox $id]
    list $a $b
} -result {{5 5 55 35} {4 4 56 36}}

test line-bbox-width-zero "width < 1 is treated as 1" -body {
    set id [.c create line 10 10 50 30 -width 0]
    .c bbox $id
} -result "8 8 52 32"

test line-bbox-fractional-coords "first point truncates, others round half up" -body {
    set id [.c create line 10.5 10.5 50.5 30.5]
    .c bbox $id
} -result "8 8 53 33"

test line-bbox-negative-first-point "negative first point truncates toward zero" -body {
    set id [.c create line -10.4 100 20 100]
    set a [.c bbox $id]
    .c coords $id 20 100 -10.4 100
    set b [.c bbox $id]
    list $a $b
} -result {{-12 98 22 102} {-11 98 22 102}}

test line-bbox-polyline "polyline bbox includes every vertex" -body {
    set id [.c create line 10 50 40 10 90 80 120 30]
    .c bbox $id
} -result "8 8 122 82"

test line-bbox-miter-acute "miter apex extends the bbox (width 20)" -body {
    set id [.c create line 0 0 100 0 10 20 -width 20 -joinstyle miter]
    set a [.c bbox $id]
    .c itemconfigure $id -joinstyle round
    set b [.c bbox $id]
    list $a $b
} -result {{-21 -21 192 41} {-21 -21 121 41}}

test line-bbox-miter-gentle "gentle miter does not exceed the padded hull" -body {
    set id [.c create line 0 0 100 0 150 50 -width 8 -joinstyle miter]
    .c bbox $id
} -result "-9 -9 159 59"

test line-bbox-smooth "smooth curves do not expand the bbox" -body {
    set id [.c create line 0 0 50 100 100 0 -smooth true]
    .c bbox $id
} -result "-2 -2 102 102"

test line-bbox-zero-width-line "zero-length line still reports a 4px box" -body {
    set id [.c create line 30 40 30 40]
    .c bbox $id
} -result "28 38 32 42"

# --- moveto -------------------------------------------------------------------
test moveto-basic "moveto aligns the bbox origin" -body {
    set id [.c create line 10 10 50 30]
    .c moveto $id 100 100
    list [.c coords $id] [.c bbox $id]
} -result {{102 102 142 122} {100 100 144 124}}

test moveto-fractional-source "moveto measures from the int bbox, not the coords" -body {
    set id [.c create line 10.7 10.2 50 30]
    .c moveto $id 100 100
    list [.c coords $id] [.c bbox $id]
} -result {{102.7 102.2 142 122} {100 100 144 124}}

test moveto-empty-x "an empty x leaves the x coordinate unchanged" -body {
    set id [.c create line 10 10 50 30]
    .c moveto $id "" 200
    list [.c coords $id] [.c bbox $id]
} -result {{10 202 50 222} {8 200 52 224}}

test moveto-empty-y "an empty y leaves the y coordinate unchanged" -body {
    set id [.c create line 10 10 50 30]
    .c moveto $id 300 ""
    list [.c coords $id] [.c bbox $id]
} -result {{302 10 342 30} {300 8 344 32}}

test moveto-empty-both "two empty strings change nothing" -body {
    set id [.c create line 10 10 50 30]
    .c moveto $id "" ""
    .c coords $id
} -result "10 10 50 30"

test moveto-tag-multiple "all matching items move by the first match's delta" -body {
    set a [.c create line 10 10 50 30 -tags grp]
    set b [.c create line 20 20 60 40 -tags grp]
    .c moveto grp 100 100
    list [.c coords $a] [.c coords $b]
} -result {{102 102 142 122} {112 112 152 132}}

test moveto-no-match "moveto with an unknown tag is a silent no-op" -body {
    .c moveto no-such-tag 10 10
} -result ""

test moveto-unknown-id "moveto with an unknown id is a silent no-op" -body {
    .c moveto 9999 10 10
} -result ""

test moveto-to-origin "moveto 0 0 shifts back by the bbox origin" -body {
    set id [.c create line 10 10 200 10]
    .c moveto $id 0 0
    list [.c coords $id] [.c bbox $id]
} -result {{2 2 192 2} {0 0 194 4}}

destroy .c

if {![info exists ::tkg_all_in_progress]} {
    cleanupTests
}
