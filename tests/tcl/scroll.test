# scroll.test — M7: xview/yview and scrollregion
package require tcltest
namespace import ::tcltest::*

if {[catch {package require tkd2dcanvas} err]} {
    puts "SKIP scroll.test: $err"
    exit 0
}

test scroll-placeholder "placeholder until M7" -body {
    expr {1}
} -result 1

if {![info exists ::tkg_all_in_progress]} {
    cleanupTests
}
