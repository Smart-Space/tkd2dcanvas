     }
 }
 
+/*
+ *----------------------------------------------------------------------
+ *
+ * AAUsable --
+ *
+ *	Determines whether a drawing primitive may be rendered with manual
+ *	anti-aliasing.  Some combinations of graphics context attributes
+ *	cannot be reproduced by the anti-aliasing engine and are left to
+ *	the plain GDI code path:
+ *
+ *	- Anything but a plain copy operation, because the engine blends
+ *	  the shape with the destination.
+ *	- Dashed lines, because the dash pattern of a GDI pen is defined
+ *	  in device pixels and would not be scaled along with the shape.
+ *	- Stippled fills, because the stipple pattern is not scaled
+ *	  either.
+ *
+ * Results:
+ *	Non-zero if the primitive may be anti-aliased.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+AAUsable(
+    GC gc)			/* Graphics context to examine. */
+{
+    if (!TkWinAAIsActive()) {
+	return 0;
+    }
+    if (gc->function != GXcopy) {
+	return 0;
+    }
+    if (gc->line_style != LineSolid) {
+	return 0;
+    }
+    if ((gc->fill_style == FillStippled)
+	    || (gc->fill_style == FillOpaqueStippled)) {
+	return 0;
+    }
+    return 1;
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
+ * AARenderObject --
+ *
+ *	Anti-aliased version of RenderObject.  The shape is rendered into
+ *	the off-screen buffer of the anti-aliasing engine, which is then
+ *	filtered down to device resolution and composited onto the
+ *	destination.
+ *
+ * Results:
+ *	1 if the shape was rendered, 0 if the caller has to fall back to
+ *	the normal code path.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+AARenderObject(
+    HDC dc,			/* DC of the destination. */
+    GC gc,			/* Graphics context to use. */
+    POINT *winPoints,		/* Points of the shape, device coordinates. */
+    int npoints,		/* Number of points in winPoints. */
+    RECT *rectPtr,		/* Bounding box of the shape. */
+    WinDrawFunc func)		/* Polyline or Polygon. */
+{
+    int scale = TkWinAAGetScale();
+    int margin = gc->line_width + 1;
+    int left = rectPtr->left - margin;
+    int top = rectPtr->top - margin;
+    int width = rectPtr->right + margin - left;
+    int height = rectPtr->bottom + margin - top;
+    HDC aaDC;
+    HPEN aaPen, oldPen;
+    HBRUSH aaBrush, oldBrush;
+    POINT *scaledPoints;
+    int i;
+
+    aaDC = TkWinAABegin(dc, left, top, width, height);
+    if (aaDC == NULL) {
+	return 0;
+    }
+    scaledPoints = (POINT *) ckalloc(sizeof(POINT) * npoints);
+    for (i = 0; i < npoints; i++) {
+	scaledPoints[i].x = (winPoints[i].x - left) * scale;
+	scaledPoints[i].y = (winPoints[i].y - top) * scale;
+    }
+    if (func == Polyline) {
+	aaPen = SetUpGraphicsPortEx(gc, TkWinAAMaskColor(), scale);
+    } else {
+	aaPen = GetStockObject(NULL_PEN);
+    }
+    oldPen = SelectObject(aaDC, aaPen);
+    aaBrush = CreateSolidBrush(TkWinAAMaskColor());
+    oldBrush = SelectObject(aaDC, aaBrush);
+    SetPolyFillMode(aaDC, (gc->fill_rule == EvenOddRule) ? ALTERNATE
+	    : WINDING);
+    MakeAndStrokePath(aaDC, scaledPoints, npoints, func);
+    SelectObject(aaDC, oldPen);
+    SelectObject(aaDC, oldBrush);
+    if (func == Polyline) {
+	DeleteObject(aaPen);
+    }
+    DeleteObject(aaBrush);
+    ckfree(scaledPoints);
+    TkWinAAEnd(dc, left, top, width, height, (COLORREF) gc->foreground);
+    return 1;
+}
+
