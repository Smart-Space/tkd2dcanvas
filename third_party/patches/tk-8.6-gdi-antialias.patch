 generic/tkCanvas.h |  21 ++
 win/makefile.vc    |   1 +
 win/tkWinAA.c      | 621 +++++++++++++++++++++++++++++++++++++++++++++
 win/tkWinAA.h      |  85 +++++++
 win/tkWinDraw.c    | 251 +++++++++++++++++-
 6 files changed, 994 insertions(+), 4 deletions(-)
 create mode 100644 win/tkWinAA.c
 create mode 100644 win/tkWinAA.h

