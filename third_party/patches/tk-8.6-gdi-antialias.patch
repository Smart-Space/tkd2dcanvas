+    {TK_CONFIG_INT, "-aafactor", "aaFactor", "AAFactor",
+	"4", Tk_Offset(TkCanvas, aaFactor), 0, NULL},
+#endif
     {TK_CONFIG_END, NULL, NULL, NULL, NULL, 0, 0, NULL}
 };
 
@@ -2588,6 +2594,16 @@ DisplayCanvas(
 	 * unmapped when they move off-screen).
 	 */
 
+#ifdef _WIN32
+	/*
+	 * On Windows the items may be anti-aliased by hand: the GDI back
