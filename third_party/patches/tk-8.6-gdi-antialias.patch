+#endif
 	for (itemPtr = canvasPtr->firstItemPtr; itemPtr != NULL;
 		itemPtr = itemPtr->nextPtr) {
 	    if ((itemPtr->x1 >= screenX2)
@@ -2610,6 +2626,9 @@ DisplayCanvas(
 	    ItemDisplay(canvasPtr, itemPtr, pixmap, screenX1, screenY1, width,
