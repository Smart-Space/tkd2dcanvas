+/*
+ *----------------------------------------------------------------------
+ *
+ * AARenderArc --
+ *
+ *	Anti-aliased version of the arc drawing code of DrawOrFillArc.  The
+ *	arc is rendered into the off-screen buffer of the anti-aliasing
+ *	engine, which is then filtered down to device resolution and
+ *	composited onto the destination.
+ *
+ * Results:
+ *	1 if the arc was rendered, 0 if the caller has to fall back to the
+ *	normal code path.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+AARenderArc(
+    HDC dc,			/* DC of the destination. */
+    GC gc,			/* Graphics context to use. */
+    int x,			/* Left edge of the bounding box. */
+    int y,			/* Top edge of the bounding box. */
+    unsigned int width,		/* Width of the bounding box. */
+    unsigned int height,	/* Height of the bounding box. */
+    int xstart, int ystart,	/* Start point of the arc. */
+    int xend, int yend,		/* End point of the arc. */
+    int fill)			/* Non-zero to fill the arc. */
+{
+    int scale = TkWinAAGetScale();
+    int margin = gc->line_width + 1;
+    int left = x - margin;
+    int top = y - margin;
+    int boxWidth = (int) width + 2 + 2 * margin;
+    int boxHeight = (int) height + 2 + 2 * margin;
+    HDC aaDC;
+    HPEN aaPen, oldPen;
+    HBRUSH aaBrush, oldBrush;
+
+    aaDC = TkWinAABegin(dc, left, top, boxWidth, boxHeight);
+    if (aaDC == NULL) {
+	return 0;
+    }
+    aaPen = SetUpGraphicsPortEx(gc, TkWinAAMaskColor(), scale);
+    oldPen = SelectObject(aaDC, aaPen);
+    if (!fill) {
+	SetBkMode(aaDC, TRANSPARENT);
+	Arc(aaDC, (x - left) * scale, (y - top) * scale,
+		(x + (int) width + 1 - left) * scale,
+		(y + (int) height + 1 - top) * scale,
+		(xstart - left) * scale, (ystart - top) * scale,
+		(xend - left) * scale, (yend - top) * scale);
+    } else {
+	aaBrush = CreateSolidBrush(TkWinAAMaskColor());
+	oldBrush = SelectObject(aaDC, aaBrush);
+	if (gc->arc_mode == ArcChord) {
+	    Chord(aaDC, (x - left) * scale, (y - top) * scale,
+		    (x + (int) width + 1 - left) * scale,
+		    (y + (int) height + 1 - top) * scale,
+		    (xstart - left) * scale, (ystart - top) * scale,
+		    (xend - left) * scale, (yend - top) * scale);
+	} else if (gc->arc_mode == ArcPieSlice) {
+	    Pie(aaDC, (x - left) * scale, (y - top) * scale,
+		    (x + (int) width + 1 - left) * scale,
+		    (y + (int) height + 1 - top) * scale,
+		    (xstart - left) * scale, (ystart - top) * scale,
+		    (xend - left) * scale, (yend - top) * scale);
+	}
+	SelectObject(aaDC, oldBrush);
+	DeleteObject(aaBrush);
+    }
+    SelectObject(aaDC, oldPen);
+    DeleteObject(aaPen);
+    TkWinAAEnd(dc, left, top, boxWidth, boxHeight, (COLORREF) gc->foreground);
+    return 1;
+}
